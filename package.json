{
  "name": "toolplan-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns a raw project idea into a polished, cost-aware first prompt: stack pick, under-recommended OSS tools, and token-saving execution directives",
  "keywords": [
    "mcp",
    "mcp-server",
    "prompt-engineering",
    "ai-agents",
    "claude",
    "tech-stack",
    "token-optimization"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaditya0602/toolplan-mcp.git"
  },
  "homepage": "https://github.com/aaditya0602/toolplan-mcp",
  "bugs": {
    "url": "https://github.com/aaditya0602/toolplan-mcp/issues"
  },
  "files": [
    "dist",
    "kb",
    "docs/KB_SCHEMA.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "toolplan-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "stale": "tsx scripts/stale.ts",
    "log-to-case": "tsx scripts/log-to-case.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
